# Generate a key: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
# DEBUG must be False in production. It is False when this line is missing.
DEBUG=True
# HTTPS-only cookies. Defaults to True when DEBUG is False; set False when testing over http://localhost
# SECURE_COOKIES=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Local PostgreSQL:
DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/brph
# Supabase (use the connection string from Project Settings > Database), then set DB_SSL_REQUIRE=True:
# DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-xx.pooler.supabase.com:5432/postgres
DB_SSL_REQUIRE=False

# File storage. Leave False to keep uploads in the local media/ folder.
# Set True to store uploads in a PRIVATE Supabase Storage bucket (Storage > S3 Connection).
USE_SUPABASE_STORAGE=False
SUPABASE_BUCKET=brph-uploads
SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
